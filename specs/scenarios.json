  "version": 1,
  "authority": "Contrato operativo de prototipo, sin modificación de documentos históricos",
  "modules": [
    {
      "id": "MOD01",
      "file": "specs/actos-versiones.md",
      "title": "Actos y versiones",
      "externalGate": null
    },
    {
